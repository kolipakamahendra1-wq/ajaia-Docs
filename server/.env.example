# Copy to server/.env and fill in. Never commit .env.
PORT=8080
NODE_ENV=development

# Local dev: a file database. Production: libsql://<your-db>.turso.io
DATABASE_URL=file:./data/ajaia.db
# Required only for Turso
DATABASE_AUTH_TOKEN=

# Required, 16+ characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin of the deployed or local frontend (CORS allowlist, comma-separated allowed)
CLIENT_ORIGIN=http://localhost:5173

# Password for the seeded demo accounts (alice@demo.com, bob@demo.com)
DEMO_PASSWORD=ajaia-demo-123
