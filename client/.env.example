# Copy to client/.env.local if needed. Never put secrets here: VITE_* values are public in the built bundle.
#
# Leave empty in local development: the Vite dev server proxies /api to http://localhost:8080.
# In production (Vercel) set this to the deployed backend, including /api, e.g.
# VITE_API_URL=https://your-service.onrender.com/api
VITE_API_URL=
